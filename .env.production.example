# Copy to .env.production on the deployment host. Never commit the real file.
COMPOSE_PROJECT_NAME=spotkick-production
# Replace both password placeholders with the SAME random hex password.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
DATABASE_URL=postgres://spotkick:REPLACE_WITH_RANDOM_HEX_PASSWORD@postgres:5432/spotkick
WEB_ORIGIN=https://spotkick.danielgil.eu
NEXT_PUBLIC_API_URL=https://api.spotkick.danielgil.eu
WEB_HOST_PORT=3300
API_HOST_PORT=3301
BOT_AFTER_MS=5000
CHOICE_MS=10000
REVEAL_MS=3000
RESULT_MS=1600
RAKE_BPS=300
GUEST_RATE_LIMIT=30
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
