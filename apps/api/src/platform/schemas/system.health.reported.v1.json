{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "type": {
      "type": "string",
      "const": "system.health.reported.v1"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "source": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "userId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "data": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "status": {
          "type": "string",
          "enum": [
            "healthy",
            "degraded",
            "unhealthy"
          ]
        },
        "latencyP95": {
          "type": "number",
          "minimum": 0,
          "description": "HTTP request latency p95 in milliseconds"
        },
        "errorRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Failed request fraction over the reporting window"
        }
      },
      "required": [
        "service",
        "status",
        "latencyP95",
        "errorRate"
      ]
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "occurredAt",
    "source",
    "correlationId",
    "data"
  ],
  "$id": "https://schemas.danigil.dev/platform/system.health.reported.v1.json"
}
